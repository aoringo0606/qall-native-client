<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 以降のクラウドバックアップ・端末間の移行から、アプリのデータをすべて外す。
  アクセストークン (flutter_secure_storage) を端末の外に出さないため。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
